# Check everything with: npm run env:check   (details: docs/ENV.md)
# --- Database (Vercel <-> Neon integration sets this) ---
DATABASE_URL=postgres://...

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Sarvam (speech) ---
SARVAM_API_KEY=
# Photos (bills, payment screenshots) are read with Sarvam Vision when this key is set; BILL_OCR=claude forces Claude
# optional overrides: SARVAM_STT_MODEL=saaras:v4  SARVAM_TTS_MODEL=bulbul:v3  SARVAM_TTS_SPEAKER=shubh

# --- WhatsApp: Twilio (primary; the sandbox works today). Steps: docs/WHATSAPP-SETUP.md ---
# Needed to SEND and to receive: all three. Webhook URL to paste in Twilio: <APP_BASE_URL>/api/twilio/webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# the sandbox / sender number, e.g. +17372508034
TWILIO_WHATSAPP_FROM=
# optional: the phrase the owner sends once to join the sandbox (shown on the connect screen)
# TWILIO_SANDBOX_JOIN_CODE=join twilio-trial
# optional: "dry" = never call Twilio, only log replies (rehearsal)
# TWILIO_SEND_MODE=dry
# optional: our own hard stop per rolling 24h (the trial allows 50). Default 40.
# TWILIO_DAILY_CAP=40
# optional: public base Twilio calls when it differs from APP_BASE_URL (e.g. a tunnel). Used to check X-Twilio-Signature.
# TWILIO_WEBHOOK_BASE=

# --- WhatsApp: Meta Cloud API (optional fallback; used only when the Twilio vars above are empty) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# optional: pre-fill the owner number when seeding (10 digits or +91...). Can also be set in the dashboard.
# OWNER_WA=
# optional: Graph API version (default v27.0)
# WHATSAPP_API_VERSION=v27.0

# --- Soundbox voice (Voice Saathi) ---
# signs spoken replies so /api/soundbox/speak is not an open TTS proxy (falls back to HASH_SALT)
SOUNDBOX_SECRET=
# per-IP voice turns per 10 minutes on the Soundbox routes (default 60)
# SOUNDBOX_TURNS_PER_10_MIN=60
# true = voice turns sent with variant "landing" never save changes (not used by the dashboard page)
# SOUNDBOX_LANDING_READONLY=true

# --- Call Saathi: reminder calls via Vobiz (console.vobiz.ai). Setup: docs/CALL-SAATHI.md ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# a DID you own on Vobiz (a 160-series number for service calls in India), e.g. +918065551234
VOBIZ_FROM_NUMBER=
# long random string; Vobiz webhooks carry it as ?k=...
VOBIZ_WEBHOOK_SECRET=
# long random string; protects POST /api/calls/run (Authorization: Bearer ...)
CALLS_CRON_SECRET=
# demo guard: dial ONLY these numbers (comma separated), whoever presses the button. Leave empty in production.
# CALLS_ALLOWED_NUMBERS=919876543210
# optional: "dry" = never call Vobiz, only log
# VOBIZ_SEND_MODE=dry
# optional: language code for <Speak> (default hi-IN)
# VOBIZ_SPEAK_LANG=hi-IN

# --- App ---
MERCHANT_UPI_ID=guptastore@paytm
APP_BASE_URL=http://localhost:3000
HASH_SALT=change-me

# --- Neon API (only for provisioning scripts, not needed at runtime) ---
NEON_API_KEY=
NEON_PROJECT_ID=   # for `npm run db:usage` (shows free-plan transfer used this month)
